# PostgreSQL connection. Defaults: localhost:5432, current OS user, no password
# (matches local peer/trust auth). Only set these to override with a role.
DB_HOST=localhost
DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=

# Google OAuth (configure the callback URL for your local app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (required for production Active Storage)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto

# Production request/application log level
RAILS_LOG_LEVEL=info

# CORS for /api (comma-separated origins allowed to call the JSON API, e.g. https://app.example.com)
API_CORS_ORIGINS=

# Resend (production transactional email — leave unset in dev/test)
RESEND_API_KEY=
RESEND_DOMAIN=

# Sentry (error tracking — leave unset in dev/test to disable)
# SENTRY_DSN is read by Rails (backend errors); VITE_SENTRY_DSN is read by
# the frontend build (browser errors) and, like all VITE_* vars, must be
# present at `vite build` time (Docker build), not just at runtime.
SENTRY_DSN=
VITE_SENTRY_DSN=

# GA4 (leave unset in dev/test to disable analytics)
VITE_GA4_MEASUREMENT_ID=
