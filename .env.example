# Google OAuth (configure the callback URL for your local app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (required for production Active Storage)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto

# Production request/application log level
RAILS_LOG_LEVEL=info

# CORS for /api (comma-separated origins allowed to call the JSON API, e.g. https://app.example.com)
API_CORS_ORIGINS=
